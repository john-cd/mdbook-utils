# Shared non-secret Compose and Dockerfile build inputs.
# Credentials belong in ignored .devcontainer/.env.local; keep this shared env file non-secret.
# TODO Reviewed ??-??-2026.
RUST_VERSION=1.100.0
CARGO_BINSTALL_VERSION=1.27.0

RUST_IMAGE_LABEL=${RUST_VERSION}-trixie

## mdBook 0.5.4 supports the user guide's Rust 2024 edition.
MDBOOK_VERSION=0.5.4
SCCACHE_VERSION=0.19.0
JUST_VERSION=1.59.0
CARGO_BUMP_VERSION=1.14.0

## Version of the Docker image to create e.g. 0.1.0
IMAGE_VERSION=latest

## Path to the project folder on the development machine.
## On Windows, something like: /d/code/mdbook-utils/; on Linux, ~/code/mdbook-utils/
## Relative paths are resolved from the Compose file’s directory e.g. use ..
ROOT_PROJECT_PATH=..

# Env. variables for Git: https://git-scm.com/book/en/v2/Git-Internals-Environment-Variables
GIT_AUTHOR_NAME="John CD"
EMAIL=16479678+john-cd@users.noreply.github.com
RUSTFMT_TOOLCHAIN=nightly-2026-11-11
COMPOSE_PROJECT_NAME=mdbook-utils-dev
